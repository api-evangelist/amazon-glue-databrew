{
  "opencollection": "1.0.0",
  "info": {
    "name": "AWS Glue DataBrew Datasets Tags API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon Glue DataBrew List Tags for Resource",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://databrew.{region}.amazonaws.com/tags/:ResourceArn",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "ResourceArn",
                "value": "",
                "type": "path",
                "description": "The Amazon Resource Name (ARN) string that uniquely identifies the DataBrew resource. "
              }
            ]
          },
          "docs": "Lists all the tags for a DataBrew resource. "
        },
        {
          "info": {
            "name": "Amazon Glue DataBrew Tag Resource",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://databrew.{region}.amazonaws.com/tags/:ResourceArn",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "ResourceArn",
                "value": "",
                "type": "path",
                "description": "The DataBrew resource to which tags should be added. The value for this parameter is an Amazon Resource Name (ARN). For DataBrew, you can tag a dataset, a job, a project, or a recipe."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds metadata tags to a DataBrew resource, such as a dataset, project, recipe, job, or schedule."
        },
        {
          "info": {
            "name": "Amazon Glue DataBrew Untag Resource",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://databrew.{region}.amazonaws.com/tags/:ResourceArn#tagKeys",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "ResourceArn",
                "value": "",
                "type": "path",
                "description": "A DataBrew resource from which you want to remove a tag or tags. The value for this parameter is an Amazon Resource Name (ARN). "
              },
              {
                "name": "tagKeys",
                "value": "",
                "type": "query",
                "description": "The tag keys (names) of one or more tags to be removed."
              }
            ]
          },
          "docs": "Removes metadata tags from a DataBrew resource."
        }
      ]
    }
  ],
  "bundled": true
}